# Barangay Information System (BIS) Frontend Environment Configuration
# Copy to .env.local for local development with a Laravel REST API backend.

# Base URL for the Laravel REST API (e.g., http://localhost:8000/api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Toggle mock data layer before connecting the live Laravel + SQLite API
NEXT_PUBLIC_USE_MOCK_DATA=true

# Barangay metadata defaults (can also be fetched from /api/v1/system/config)
NEXT_PUBLIC_BARANGAY_NAME=Barangay Cebole
NEXT_PUBLIC_BARANGAY_LOCATION=Quezon, Bukidnon
